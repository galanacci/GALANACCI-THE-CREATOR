(() => {
  "use strict";

  const boot = document.getElementById("gtc-os-boot");
  const BOOT_DURATION_MS = 3700;

  const url = new URL(window.location.href);
  const returningFromPog = url.searchParams.get("return") === "pog";

  function cleanReturnMarker() {
    url.searchParams.delete("return");

    const cleanUrl =
      url.pathname +
      (url.searchParams.toString() ? `?${url.searchParams.toString()}` : "") +
      url.hash;

    window.history.replaceState(
      window.history.state,
      "",
      cleanUrl || "/"
    );
  }

  function skipBootForPogReturn() {
    /*
      PoG.EXE was launched from this desktop, so EXIT should behave like
      closing an application â€” not like starting GALANACCI OS again.
    */
    document.body.classList.remove("gtc-os-boot-active");
    boot?.remove();

    /*
      WELCOME is an initial-entry notice. Do not replay it when returning
      from an external GALANACCI application.
    */
    const noticeLayer = document.getElementById("portfolio-notice-layer");

    if (noticeLayer) {
      noticeLayer.hidden = true;
      noticeLayer.setAttribute("aria-hidden", "true");
    }

    cleanReturnMarker();
  }

  function completeBoot() {
    if (!boot) return;

    /* Approved hard cut. */
    document.body.classList.remove("gtc-os-boot-active");
    boot.remove();

    /*
      Normal direct visits retain the existing WELCOME notification,
      which has already initialised underneath the startup screen.
    */
  }

  if (returningFromPog) {
    skipBootForPogReturn();
    return;
  }

  window.setTimeout(completeBoot, BOOT_DURATION_MS);
})();