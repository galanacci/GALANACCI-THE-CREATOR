(() => {
  "use strict";

  const boot = document.getElementById("gtc-os-boot");
  const BOOT_DURATION_MS = 3700;

  function pixelateMark() {
    if (!boot) return;

    const source = boot.querySelector(".gtc-os-boot__mark-source");
    const canvas = boot.querySelector(".gtc-os-boot__mark-canvas");

    if (!source || !canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    /*
      Render the SVG favicon to a deliberately tiny raster first,
      then scale it back up without smoothing. This creates actual
      pixel blocks instead of merely applying CSS to a vector image.
    */
    const lowRes = document.createElement("canvas");
    lowRes.width = 30;
    lowRes.height = 30;

    const lowCtx = lowRes.getContext("2d", { alpha: true });
    if (!lowCtx) return;

    const draw = () => {
      lowCtx.clearRect(0, 0, lowRes.width, lowRes.height);
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      lowCtx.imageSmoothingEnabled = false;
      ctx.imageSmoothingEnabled = false;

      lowCtx.drawImage(source, 0, 0, lowRes.width, lowRes.height);

      ctx.drawImage(
        lowRes,
        0,
        0,
        lowRes.width,
        lowRes.height,
        0,
        0,
        canvas.width,
        canvas.height
      );
    };

    if (source.complete) {
      draw();
    } else {
      source.addEventListener("load", draw, { once: true });
    }
  }

  function completeBoot() {
    if (!boot) return;

    /* Approved hard cut: no fade, no scaling transition. */
    document.body.classList.remove("gtc-os-boot-active");
    boot.remove();

    /*
      The existing GALANACCI OS 26 notification has already initialised
      underneath and becomes visible immediately after this cut.
    */
  }

  pixelateMark();
  window.setTimeout(completeBoot, BOOT_DURATION_MS);
})();