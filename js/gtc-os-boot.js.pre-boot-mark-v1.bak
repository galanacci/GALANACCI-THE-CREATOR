(() => {
  "use strict";

  const boot = document.getElementById("gtc-os-boot");
  const BOOT_DURATION_MS = 3700;

  function completeBoot() {
    if (!boot) return;

    /* Hard cut. No fade / scale transition. */
    document.body.classList.remove("gtc-os-boot-active");
    boot.remove();

    /*
      gtc-ui-enhancements.js has already initialised the existing:
      "You are now using GALANACCI OS 26"
      notice underneath the boot screen. Removing the body class
      reveals that existing notification immediately.
    */
  }

  window.setTimeout(completeBoot, BOOT_DURATION_MS);
})();