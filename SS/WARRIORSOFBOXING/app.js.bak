const ARCHIVE_PATHS = [
  './archive/manifest.json',
  './demo/manifest.json',
];

const canvas = document.getElementById('viewer');
const ctx = canvas.getContext('2d', { alpha: false });
const nameEl = document.getElementById('fighterName');
const countEl = document.getElementById('fighterCount');
const closeBtn = document.querySelector('.app-close');

const state = {
  entries: [],
  current: 0,
  currentImg: null,
  nextImg: null,
  cache: new Map(),
  frameA: document.createElement('canvas'),
  frameB: document.createElement('canvas'),
  holdMs: 900,
  morphMs: 2200,
  startedAt: 0,
  running: true,
  paused: false,
};

function fitRect(imgW, imgH, boxW, boxH) {
  const scale = Math.min(boxW / imgW, boxH / imgH);
  const w = imgW * scale;
  const h = imgH * scale;
  return { x: (boxW - w) / 2, y: (boxH - h) / 2, w, h };
}

function resize() {
  const dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
  const rect = canvas.getBoundingClientRect();
  canvas.width = Math.round(rect.width * dpr);
  canvas.height = Math.round(rect.height * dpr);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  render(performance.now());
}

function ease(t) {
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

function normaliseName(stem) {
  return stem
    .replace(/[_-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toUpperCase();
}

async function loadManifest() {
  for (const path of ARCHIVE_PATHS) {
    try {
      const res = await fetch(path, { cache: 'no-store' });
      if (!res.ok) continue;
      const json = await res.json();
      if (Array.isArray(json.entries) && json.entries.length) return json.entries;
    } catch (err) {}
  }
  throw new Error('Could not load manifest.json from archive/ or demo/.');
}

function loadImage(src) {
  if (state.cache.has(src)) return state.cache.get(src);
  const p = new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = src;
  });
  state.cache.set(src, p);
  return p;
}

async function prepareEntry(index) {
  const entry = state.entries[(index + state.entries.length) % state.entries.length];
  const img = await loadImage(entry.image);
  return { entry, img };
}

function setLabels() {
  const currentEntry = state.entries[state.current];
  nameEl.textContent = currentEntry.name;
  countEl.textContent = `${String(state.current + 1).padStart(3, '0')} / ${String(state.entries.length).padStart(3, '0')}`;
}

async function primeImages() {
  const current = await prepareEntry(state.current);
  const next = await prepareEntry((state.current + 1) % state.entries.length);
  state.currentImg = current.img;
  state.nextImg = next.img;
  setLabels();
}

function drawPortraitToBuffer(buffer, img) {
  const bctx = buffer.getContext('2d');
  const w = canvas.clientWidth;
  const h = canvas.clientHeight;
  buffer.width = w;
  buffer.height = h;
  bctx.clearRect(0, 0, w, h);
  bctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim() || '#f6f3ee';
  bctx.fillRect(0, 0, w, h);
  const bounds = fitRect(img.naturalWidth, img.naturalHeight, w, h);
  bctx.drawImage(img, bounds.x, bounds.y, bounds.w, bounds.h);
}

function drawMorph(imgA, imgB, t) {
  const w = canvas.clientWidth;
  const h = canvas.clientHeight;
  drawPortraitToBuffer(state.frameA, imgA);
  drawPortraitToBuffer(state.frameB, imgB);

  ctx.clearRect(0, 0, w, h);
  ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim() || '#f6f3ee';
  ctx.fillRect(0, 0, w, h);

  const bands = Math.max(48, Math.floor(h / 14));
  const sliceH = h / bands;
  const ampA = Math.max(6, w * 0.018) * (1 - t);
  const ampB = Math.max(6, w * 0.018) * t;

  ctx.imageSmoothingEnabled = true;

  for (let i = 0; i < bands; i++) {
    const sy = i * sliceH;
    const oscillation = Math.sin(i * 0.36 + t * Math.PI * 2.0);
    const drift = Math.cos(i * 0.21 + t * Math.PI * 1.5);

    ctx.globalAlpha = 1 - t;
    const dxA = oscillation * ampA - t * 18 + drift * ampA * 0.15;
    ctx.drawImage(state.frameA, 0, sy, w, sliceH + 1, dxA, sy, w, sliceH + 1);

    ctx.globalAlpha = t;
    const dxB = oscillation * -ampB + (1 - t) * 18 + drift * -ampB * 0.15;
    ctx.drawImage(state.frameB, 0, sy, w, sliceH + 1, dxB, sy, w, sliceH + 1);
  }

  ctx.globalAlpha = (1 - t) * 0.16;
  ctx.drawImage(state.frameA, -6 * t, 0, w + 12 * t, h);
  ctx.globalAlpha = t * 0.16;
  ctx.drawImage(state.frameB, 6 * (1 - t), 0, w - 12 * (1 - t), h);

  ctx.globalAlpha = 1;
}

function drawStill(img) {
  const w = canvas.clientWidth;
  const h = canvas.clientHeight;
  ctx.clearRect(0, 0, w, h);
  ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim() || '#f6f3ee';
  ctx.fillRect(0, 0, w, h);
  const bounds = fitRect(img.naturalWidth, img.naturalHeight, w, h);
  ctx.drawImage(img, bounds.x, bounds.y, bounds.w, bounds.h);
}

async function advance() {
  state.current = (state.current + 1) % state.entries.length;
  const current = await prepareEntry(state.current);
  const next = await prepareEntry((state.current + 1) % state.entries.length);
  state.currentImg = current.img;
  state.nextImg = next.img;
  setLabels();
  state.startedAt = performance.now();
}

function render(now) {
  if (!state.currentImg) return;
  if (state.paused) {
    drawStill(state.currentImg);
    return;
  }

  if (!state.startedAt) state.startedAt = now;
  const elapsed = now - state.startedAt;

  if (elapsed < state.holdMs) {
    drawStill(state.currentImg);
  } else if (elapsed < state.holdMs + state.morphMs) {
    const t = ease((elapsed - state.holdMs) / state.morphMs);
    drawMorph(state.currentImg, state.nextImg, t);
  } else {
    advance();
  }

  if (state.running) requestAnimationFrame(render);
}

function tryClose() {
  if (window.parent && window.parent !== window) {
    window.parent.postMessage({ type: 'close-exe', app: 'WARRIORSOFBOXING.EXE' }, '*');
  }
  if (history.length > 1) {
    history.back();
  } else {
    window.location.href = '../../index.html';
  }
}

closeBtn.addEventListener('click', tryClose);
window.addEventListener('resize', resize);
canvas.addEventListener('click', () => {
  state.paused = !state.paused;
  if (!state.paused) {
    state.startedAt = performance.now() - Math.min(state.holdMs, 250);
    requestAnimationFrame(render);
  } else {
    render(performance.now());
  }
});

(async function init() {
  const entries = await loadManifest();
  state.entries = entries.map((entry) => ({
    name: entry.name ? normaliseName(entry.name) : normaliseName(entry.image.split('/').pop().replace(/\.[^.]+$/, '')),
    image: entry.image,
  }));
  await primeImages();
  resize();
  requestAnimationFrame(render);
})().catch((err) => {
  console.error(err);
  nameEl.textContent = 'ARCHIVE ERROR';
  countEl.textContent = '--- / ---';
});
