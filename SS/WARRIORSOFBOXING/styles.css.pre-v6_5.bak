:root {
  --chrome: #dcc8ab;
  --chrome-line: #111;
  --paper: #d8cfbf;
  --ink: #111;
}

* { box-sizing: border-box; }
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--paper);
  color: var(--ink);
  font-family: "Times New Roman", Georgia, serif;
}

button, canvas, .app-main { touch-action: none; }

.app-shell {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-rows: 42px 1fr;
  background: var(--paper);
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14px;
  background: var(--chrome);
  border-bottom: 1px solid rgba(17,17,17,.18);
  user-select: none;
}

.app-title {
  font-size: 18px;
  letter-spacing: 0.12em;
  font-weight: 700;
}

.app-close {
  border: 0;
  background: transparent;
  color: #111;
  font-size: 30px;
  line-height: 1;
  cursor: pointer;
  padding: 0 0 2px;
}

.app-main {
  position: relative;
  min-height: 0;
  background: var(--paper);
  overflow: hidden;
}

#viewer {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--paper);
}

.hud {
  position: absolute;
  z-index: 10;
  pointer-events: none;
}

.hud--name {
  top: clamp(16px, 2.8vw, 28px);
  left: 50%;
  transform: translateX(-50%);
  width: min(78vw, 860px);
  text-align: center;
}

#fighterName {
  display: inline-block;
  font-size: clamp(18px, 2.4vw, 34px);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

body.is-dragging,
body.is-dragging * {
  cursor: ew-resize !important;
}

@media (max-width: 768px) {
  .app-shell { grid-template-rows: 48px 1fr; }
  .app-title {
    font-size: 16px;
    letter-spacing: 0.10em;
  }
  .app-header {
    padding-left: max(14px, env(safe-area-inset-left));
    padding-right: max(14px, env(safe-area-inset-right));
  }
  .hud--name {
    top: max(20px, env(safe-area-inset-top) + 10px);
    width: min(88vw, 520px);
  }
  #fighterName {
    font-size: clamp(14px, 4.8vw, 24px);
    letter-spacing: 0.12em;
  }
}
