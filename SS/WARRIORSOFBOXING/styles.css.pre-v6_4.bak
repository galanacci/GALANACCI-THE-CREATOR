:root {
  --paper: #E3D6C3;
  --ink: #111111;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  overscroll-behavior: none;
  background: var(--paper);
  color: var(--ink);
}

body {
  position: fixed;
  inset: 0;
  font-family: "Times New Roman", Georgia, serif;
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;
}

.app-main {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: var(--paper);
  cursor: ew-resize;
  touch-action: none;
}

.app-main.is-dragging {
  cursor: grabbing;
}

#viewer {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  background: var(--paper);
  touch-action: none;
}

.hud {
  position: absolute;
  z-index: 10;
  bottom: max(18px, env(safe-area-inset-bottom));
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  pointer-events: none;
}

.hud--name {
  left: max(18px, env(safe-area-inset-left));
  right: 150px;
  min-height: 28px;
  overflow: hidden;
}

.hud--count {
  right: max(18px, env(safe-area-inset-right));
}

.fighter-name {
  display: block;
  overflow: hidden;
  font-size: clamp(13px, 1.55vw, 21px);
  font-weight: 700;
  letter-spacing: .12em;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-shadow: none;
  outline: 0;
  border: 0;
}

.fighter-name--current {
  position: relative;
  opacity: 1;
  transform: translateY(0);
}

.fighter-name--next {
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  opacity: 0;
  transform: translateY(8px);
}

#fighterCount {
  display: block;
  border: 0;
  outline: 0;
  background: transparent;
  box-shadow: none;
  font-size: clamp(11px, 1.05vw, 15px);
  font-weight: 700;
  letter-spacing: .12em;
  line-height: 1.25;
  white-space: nowrap;
  text-shadow: none;
}

@media (max-width: 768px) {
  .hud {
    bottom: max(12px, env(safe-area-inset-bottom));
  }

  .hud--name {
    left: max(12px, env(safe-area-inset-left));
    right: 108px;
  }

  .hud--count {
    right: max(12px, env(safe-area-inset-right));
  }
}
