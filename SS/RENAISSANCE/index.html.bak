<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title>RENAISSANCE.EXE</title>
  <link rel="stylesheet" href="./renaissance.css?v=1">
</head>
<body>
  <main id="viewer" class="viewer" aria-label="RENAISSANCE artwork viewer">
    <canvas id="art-canvas" class="art-canvas" aria-hidden="true"></canvas>

    <aside id="navigator" class="navigator" aria-label="Artwork navigator">
      <img id="navigator-image" alt="">
      <div id="navigator-window" class="navigator__window" aria-hidden="true"></div>
    </aside>

    <nav class="controls" aria-label="Artwork navigation">
      <button id="previous" type="button">← PREVIOUS</button>
      <span id="counter" class="controls__counter">001 / 001</span>
      <button id="next" type="button">NEXT →</button>
    </nav>

    <div id="status" class="status" role="status" aria-live="polite"></div>
  </main>

  <script type="module" src="./renaissance.js?v=1"></script>
</body>
</html>
