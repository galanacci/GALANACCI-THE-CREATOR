<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title>EVERYDAYS.EXE</title>
  <link rel="stylesheet" href="./everydays.css?v=1">
</head>
<body>
  <main id="mosaic" class="mosaic" aria-label="EVERYDAYS image archive">
    <div id="mosaic-grid" class="mosaic__grid" aria-live="polite"></div>
    <div id="preview" class="preview" aria-hidden="true">
      <img id="preview-image" alt="">
    </div>
    <div id="status" class="status" role="status" aria-live="polite"></div>
  </main>
  <script type="module" src="./everydays.js?v=1"></script>
</body>
</html>
