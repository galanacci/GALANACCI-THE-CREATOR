/* ================================================================
   GALANACCI OS â€” PRODUCTION BOOT V3
   Approved hierarchy:
   1. GALANACCI logo
   2. WORLD BUILDING â€¢ EXPERIMENTS â€¢ ARCHIVES
   3. GALANACCI OS
   ================================================================ */

@font-face {
  font-family: "Windows95";
  src: url("../assets/fonts/w95fa.woff2") format("woff2");
  font-display: swap;
}

body.gtc-os-boot-active .portfolio-notice-layer {
  display: none !important;
}

.gtc-os-boot {
  position: fixed;
  inset: 0;
  z-index: 2147483647;

  width: 100vw;
  height: 100vh;
  height: 100dvh;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    linear-gradient(rgba(234, 209, 178, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(234, 209, 178, 0.06) 1px, transparent 1px),
    #080808;
  background-size: 16px 16px;

  color: #EAD1B2;
}

.gtc-os-boot__content {
  width: min(800px, calc(100vw - 48px));

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  transform: translateY(-2.5vh);
}

/* 1. ORIGINAL GALANACCI LOGO */

.gtc-os-boot__mark {
  width: clamp(190px, 19vw, 270px);
  height: clamp(190px, 19vw, 270px);

  display: block;
  object-fit: contain;

  margin: 0 auto;
}

/* 2. WORLD BUILDING â€¢ EXPERIMENTS â€¢ ARCHIVES */

.gtc-os-boot__meta {
  margin-top: 34px;

  font-family: "Windows95", "Courier New", monospace;
  font-size: clamp(14px, 1.35vw, 18px);
  line-height: 1.35;
  letter-spacing: 0.105em;

  text-align: center;
  white-space: nowrap;

  color: #EAD1B2;
}

/* 3. GALANACCI OS */

.gtc-os-boot__identity {
  margin-top: 42px;

  text-align: center;
  font-family: "Windows95", "Courier New", monospace;
  text-transform: uppercase;
}

.gtc-os-boot__title {
  font-size: clamp(34px, 3.8vw, 52px);
  line-height: .95;
  letter-spacing: .025em;
  white-space: nowrap;
}

.gtc-os-boot__os {
  margin-top: 8px;

  font-size: clamp(14px, 1.25vw, 18px);
  line-height: 1;
  letter-spacing: .36em;

  padding-left: .36em;
}

/* APPROVED FULL-WIDTH STEPPED LOADING BAR */

.gtc-os-boot__loading {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  width: 100%;
  height: 12px;

  border-top: 1px solid rgba(234, 209, 178, 0.18);

  background: linear-gradient(
    0.25turn,
    transparent,
    #EAD1B2 45% 55%,
    transparent
  );

  animation: gtcOsBootLoading steps(16) 2s infinite;
}

@keyframes gtcOsBootLoading {
  0%   { background-position-x: -512px; }
  100% { background-position-x: 512px; }
}

@media (min-width: 1500px) and (min-height: 800px) {
  .gtc-os-boot__mark {
    width: 290px;
    height: 290px;
  }

  .gtc-os-boot__meta {
    margin-top: 38px;
    font-size: 18px;
  }

  .gtc-os-boot__identity {
    margin-top: 48px;
  }

  .gtc-os-boot__title {
    font-size: 54px;
  }
}

@media (max-height: 720px) and (min-width: 701px) {
  .gtc-os-boot__content {
    transform: translateY(-1vh);
  }

  .gtc-os-boot__mark {
    width: 170px;
    height: 170px;
  }

  .gtc-os-boot__meta {
    margin-top: 24px;
  }

  .gtc-os-boot__identity {
    margin-top: 28px;
  }
}

@media (max-width: 700px) {
  .gtc-os-boot__content {
    width: calc(100vw - 30px);
    transform: translateY(-2vh);
  }

  .gtc-os-boot__mark {
    width: clamp(150px, 47vw, 205px);
    height: clamp(150px, 47vw, 205px);
  }

  .gtc-os-boot__meta {
    margin-top: 28px;
    padding: 0 12px;

    font-size: clamp(10px, 3.1vw, 13px);
    letter-spacing: .075em;
    line-height: 1.45;

    white-space: normal;
  }

  .gtc-os-boot__identity {
    margin-top: 34px;
  }

  .gtc-os-boot__title {
    font-size: clamp(30px, 8.5vw, 40px);
  }

  .gtc-os-boot__os {
    margin-top: 7px;
    font-size: 13px;
  }
}