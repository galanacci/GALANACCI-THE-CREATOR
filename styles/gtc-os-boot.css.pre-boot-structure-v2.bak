/* ================================================================
   GALANACCI OS 26 â€” BOOT MARK PATCH V1
   Pixelated mark + OS superscript badge.
   ================================================================ */

@font-face {
  font-family: "Windows95";
  src: url("../assets/fonts/w95fa.woff2") format("woff2");
  font-display: swap;
}

body.gtc-os-boot-active .portfolio-notice-layer {
  display: none !important;
}

.gtc-os-boot {
  position: fixed;
  inset: 0;
  z-index: 2147483647;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  display: grid;
  place-items: center;
  overflow: hidden;
  background:
    linear-gradient(rgba(234, 209, 178, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(234, 209, 178, 0.06) 1px, transparent 1px),
    #080808;
  background-size: 16px 16px;
  color: #EAD1B2;
}

.gtc-os-boot__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateY(-2vh);
}

.gtc-os-boot__brand {
  display: flex;
  align-items: center;
  gap: 22px;
}

.gtc-os-boot__mark-wrap {
  position: relative;
  width: 118px;
  height: 118px;
  flex: 0 0 auto;
}

.gtc-os-boot__mark-canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

.gtc-os-boot__mark-os {
  position: absolute;
  top: 6px;
  right: 6px;
  transform: translate(58%, -42%);
  font-family: "Windows95", "Courier New", monospace;
  font-size: 16px;
  line-height: 1;
  letter-spacing: 1px;
  color: #EAD1B2;
  text-transform: uppercase;
}

.gtc-os-boot__identity {
  min-width: 0;
}

.gtc-os-boot__title {
  font-family: "Windows95", "Courier New", monospace;
  font-size: 54px;
  line-height: 1;
  letter-spacing: -1px;
  white-space: nowrap;
}

.gtc-os-boot__os {
  margin-top: 4px;
  font-family: "Windows95", "Courier New", monospace;
  font-size: 15px;
  letter-spacing: 7px;
}

.gtc-os-boot__meta {
  margin-top: 26px;
  font-family: "Windows95", "Courier New", monospace;
  font-size: 11px;
  letter-spacing: 2px;
  opacity: 0.72;
  white-space: nowrap;
}

.gtc-os-boot__loading {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 12px;
  background: linear-gradient(
    0.25turn,
    transparent,
    #EAD1B2 45% 55%,
    transparent
  );
  animation: gtcOsBootLoading steps(16) 2s infinite;
}

@keyframes gtcOsBootLoading {
  0%   { background-position-x: -512px; }
  100% { background-position-x: 512px; }
}

@media (min-width: 1500px) {
  .gtc-os-boot__brand {
    gap: 28px;
  }
  .gtc-os-boot__mark-wrap {
    width: 138px;
    height: 138px;
  }
  .gtc-os-boot__mark-os {
    font-size: 18px;
    top: 7px;
    right: 7px;
  }
  .gtc-os-boot__title {
    font-size: 64px;
  }
  .gtc-os-boot__os {
    font-size: 17px;
    letter-spacing: 8px;
  }
  .gtc-os-boot__meta {
    font-size: 12px;
    letter-spacing: 2.2px;
  }
}

@media (max-width: 700px) {
  .gtc-os-boot__brand {
    gap: 14px;
  }
  .gtc-os-boot__mark-wrap {
    width: clamp(72px, 20vw, 104px);
    height: clamp(72px, 20vw, 104px);
  }
  .gtc-os-boot__mark-os {
    font-size: clamp(10px, 2.8vw, 13px);
    top: 4px;
    right: 4px;
  }
  .gtc-os-boot__title {
    font-size: clamp(31px, 9vw, 46px);
  }
  .gtc-os-boot__os {
    font-size: 11px;
    letter-spacing: 5px;
  }
  .gtc-os-boot__meta {
    margin-top: 21px;
    padding: 0 14px;
    font-size: 8px;
    letter-spacing: 1.25px;
    text-align: center;
    white-space: normal;
  }
}