/* GTC ENTRY RETURN V4.1 START */
html.gtc-entry-from-pog .gtc-os-boot {
  display: none !important;
}

html.gtc-entry-from-pog .portfolio-notice-layer {
  display: none !important;
}
/* GTC ENTRY RETURN V4.1 END */
/* ================================================================
   GALANACCI OS â€” BOOT SCALE RATIO V3.2

   Presentation order remains:
   1. Logo
   2. GALANACCI OS
   3. WORLD BUILDING â€¢ EXPERIMENTS â€¢ ARCHIVES
   4. Loading bar

   Visual hierarchy target:
   LOGO = 80%
   WORLD BUILDING... = 25%
   GALANACCI OS = 10%
   ================================================================ */

@font-face {
  font-family: "Windows95";
  src: url("../assets/fonts/w95fa.woff2") format("woff2");
  font-display: swap;
}

body.gtc-os-boot-active .portfolio-notice-layer {
  display: none !important;
}

.gtc-os-boot {
  position: fixed;
  inset: 0;
  z-index: 2147483647;

  width: 100vw;
  height: 100vh;
  height: 100dvh;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    linear-gradient(rgba(234, 209, 178, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(234, 209, 178, 0.06) 1px, transparent 1px),
    #080808;
  background-size: 16px 16px;

  color: #EAD1B2;
}

.gtc-os-boot__content {
  width: min(900px, calc(100vw - 48px));

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  transform: translateY(-2vh);
}

/* ================================================================
   LOGO â€” 80% VISUAL SCALE
   Dominates the composition.
   ================================================================ */

.gtc-os-boot__mark {
  width: min(80vw, 620px);
  height: min(80vw, 620px);

  max-width: 80%;
  max-height: 52vh;

  display: block;
  object-fit: contain;

  margin: 0 auto;
}

/* ================================================================
   GALANACCI OS â€” 10% VISUAL SCALE
   Supporting system label only.
   ================================================================ */

.gtc-os-boot__identity {
  margin-top: 12px;

  text-align: center;
  font-family: "Windows95", "Courier New", monospace;
  text-transform: uppercase;
}

.gtc-os-boot__title {
  font-size: clamp(18px, 1.8vw, 27px);
  line-height: 1;
  letter-spacing: .03em;
  white-space: nowrap;
}

.gtc-os-boot__os {
  margin-top: 5px;

  font-size: clamp(8px, .8vw, 11px);
  line-height: 1;
  letter-spacing: .4em;

  padding-left: .4em;
}

/* ================================================================
   WORLD BUILDING... â€” 25% VISUAL SCALE
   Clearly stronger than the OS identity, but secondary to logo.
   ================================================================ */

.gtc-os-boot__meta {
  margin-top: 38px;
  padding: 0 18px;

  font-family: "Windows95", "Courier New", monospace;
  font-size: clamp(18px, 2.5vw, 30px);
  line-height: 1.35;
  letter-spacing: .09em;

  text-align: center;
  white-space: nowrap;

  color: #EAD1B2;
}

/* ================================================================
   LOADING BAR
   ================================================================ */

.gtc-os-boot__loading {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  width: 100%;
  height: 12px;

  border-top: 1px solid rgba(234, 209, 178, 0.18);

  background: linear-gradient(
    0.25turn,
    transparent,
    #EAD1B2 45% 55%,
    transparent
  );

  animation: gtcOsBootLoading steps(16) 2s infinite;
}

@keyframes gtcOsBootLoading {
  0%   { background-position-x: -512px; }
  100% { background-position-x: 512px; }
}

/* Large desktop */
@media (min-width: 1500px) and (min-height: 850px) {
  .gtc-os-boot__mark {
    width: min(80vw, 680px);
    height: min(80vw, 680px);
    max-height: 54vh;
  }

  .gtc-os-boot__meta {
    margin-top: 44px;
    font-size: 31px;
  }

  .gtc-os-boot__title {
    font-size: 28px;
  }

  .gtc-os-boot__os {
    font-size: 11px;
  }
}

/* Shorter laptop screens */
@media (max-height: 760px) and (min-width: 701px) {
  .gtc-os-boot__content {
    transform: translateY(-1vh);
  }

  .gtc-os-boot__mark {
    width: min(65vw, 390px);
    height: min(65vw, 390px);
    max-height: 45vh;
  }

  .gtc-os-boot__meta {
    margin-top: 24px;
    font-size: clamp(15px, 2vw, 21px);
  }
}

/* Mobile */
@media (max-width: 700px) {
  .gtc-os-boot__content {
    width: calc(100vw - 24px);
    transform: translateY(-1.5vh);
  }

  .gtc-os-boot__mark {
    width: 80vw;
    height: 80vw;

    max-width: 330px;
    max-height: 42vh;
  }

  .gtc-os-boot__identity {
    margin-top: 10px;
  }

  .gtc-os-boot__title {
    font-size: clamp(17px, 5vw, 23px);
  }

  .gtc-os-boot__os {
    font-size: 8px;
  }

  .gtc-os-boot__meta {
    width: 100%;
    margin-top: 28px;
    padding: 0 4px;

    font-size: clamp(13px, 4.2vw, 18px);
    line-height: 1.45;
    letter-spacing: .065em;

    white-space: normal;
  }
}

/* GTC BOOT SEQUENCE VERSION COUNTER V1 START */
/*
  Boot sketch update:
  - keep logo sizing from existing rules
  - GALANACCI OS beneath logo
  - VERSION_XXX beneath GALANACCI OS
  - hard-cut WORLD BUILDING / EXPERIMENTS / ARCHIVES sequence
  - loading bar remains unchanged
*/

.gtc-os-boot__identity {
  width: min(80vw, 620px);
  max-width: 80%;
  margin-top: 12px;
  text-align: center;
  font-family: "Windows95", "Courier New", monospace;
  text-transform: uppercase;
}

.gtc-os-boot__title {
  width: 100%;
  font-size: clamp(15px, 1.55vw, 23px);
  line-height: 1;
  letter-spacing: .055em;
  white-space: nowrap;
}

.gtc-os-boot__version {
  margin-top: 7px;
  font-size: clamp(8px, .75vw, 11px);
  line-height: 1;
  letter-spacing: .24em;
  white-space: nowrap;
  opacity: .86;
}

.gtc-os-boot__os {
  display: none !important;
}

.gtc-os-boot__meta {
  position: relative;
  width: min(900px, calc(100vw - 48px));
  min-height: 1.35em;
  margin-top: 44px;
  padding: 0 18px;
  font-family: "Windows95", "Courier New", monospace;
  font-size: clamp(30px, 5.1vw, 68px);
  line-height: 1;
  letter-spacing: .065em;
  text-align: center;
  white-space: nowrap;
  color: #EAD1B2;
}

.gtc-os-boot__word {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  opacity: 0;
  animation-duration: 3700ms;
  animation-timing-function: steps(1, end);
  animation-fill-mode: both;
  animation-iteration-count: 1;
}

.gtc-os-boot__word--world {
  animation-name: gtcBootWordWorld;
}

.gtc-os-boot__word--experiments {
  animation-name: gtcBootWordExperiments;
}

.gtc-os-boot__word--archives {
  animation-name: gtcBootWordArchives;
}

@keyframes gtcBootWordWorld {
  0%, 33.332% { opacity: 1; }
  33.333%, 100% { opacity: 0; }
}

@keyframes gtcBootWordExperiments {
  0%, 33.332% { opacity: 0; }
  33.333%, 66.665% { opacity: 1; }
  66.666%, 100% { opacity: 0; }
}

@keyframes gtcBootWordArchives {
  0%, 66.665% { opacity: 0; }
  66.666%, 100% { opacity: 1; }
}

@media (min-width: 1500px) and (min-height: 850px) {
  .gtc-os-boot__identity {
    width: min(80vw, 680px);
  }

  .gtc-os-boot__title {
    font-size: 24px;
  }

  .gtc-os-boot__version {
    font-size: 11px;
  }

  .gtc-os-boot__meta {
    margin-top: 48px;
    font-size: clamp(42px, 5vw, 76px);
  }
}

@media (max-height: 760px) and (min-width: 701px) {
  .gtc-os-boot__identity {
    width: min(65vw, 390px);
  }

  .gtc-os-boot__meta {
    margin-top: 30px;
    font-size: clamp(24px, 4.2vw, 46px);
  }
}

@media (max-width: 700px) {
  .gtc-os-boot__identity {
    width: 80vw;
    max-width: 330px;
    margin-top: 10px;
  }

  .gtc-os-boot__title {
    font-size: clamp(13px, 4.2vw, 18px);
    letter-spacing: .05em;
  }

  .gtc-os-boot__version {
    margin-top: 6px;
    font-size: 8px;
    letter-spacing: .18em;
  }

  .gtc-os-boot__meta {
    width: calc(100vw - 24px);
    margin-top: 34px;
    padding: 0 4px;
    font-size: clamp(25px, 9.4vw, 44px);
    letter-spacing: .04em;
    white-space: nowrap;
  }
}

@media (prefers-reduced-motion: reduce) {
  .gtc-os-boot__word {
    animation: none;
  }

  .gtc-os-boot__word--world {
    opacity: 1;
  }
}
/* GTC BOOT SEQUENCE VERSION COUNTER V1 END */
