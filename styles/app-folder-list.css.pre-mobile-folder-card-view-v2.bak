.app-folder-body {
  position: relative;
  display: block;
  flex: 1 1 auto;
  min-height: 0;
  padding: 0;
  overflow: auto;
  background: var(--bg);
  background-image: none;
}

.app-folder-window {
  width: min(720px, calc(100vw - 32px));
  height: min(420px, calc(100vh - 48px));
  min-width: 420px;
}

.app-list {
  width: 100%;
  min-width: 560px;
  color: var(--fg);
  font-family: var(--font-brand);
}

.app-list__header,
.app-list__row {
  display: grid;
  grid-template-columns: minmax(250px, 1fr) 140px 150px;
  align-items: center;
  width: 100%;
}

.app-list__header {
  position: sticky;
  top: 0;
  z-index: 2;
  min-height: 34px;
  border-bottom: 1px solid rgba(0, 0, 0, .22);
  background: var(--bg);
  color: rgba(0, 0, 0, .58);
  font-size: 8px;
  font-weight: 600;
  letter-spacing: .11em;
}

.app-list__header > span,
.app-list__row > span {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 100%;
  padding: 0 12px;
}

.app-list__header > span + span,
.app-list__row > span + span {
  border-left: 1px solid rgba(0, 0, 0, .10);
}

.app-list__row {
  position: relative;
  min-height: 52px;
  border-bottom: 1px solid rgba(0, 0, 0, .10);
  background: transparent;
  color: var(--fg);
  text-decoration: none;
  cursor: default;
}

.app-list__row:hover {
  background: rgba(0, 0, 0, .055);
}

.app-list__row.is-selected,
.app-list__row:focus-visible {
  outline: 0;
  background: rgba(0, 0, 0, .13);
}

.app-list__name {
  gap: 10px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .045em;
}

.app-list__name img {
  flex: 0 0 30px;
  width: 30px;
  height: 30px;
  object-fit: contain;
  pointer-events: none;
}

.app-list__name span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-list__meta {
  overflow: hidden;
  color: rgba(0, 0, 0, .68);
  font-size: 9px;
  letter-spacing: .045em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-list__empty {
  min-height: 52px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  border-bottom: 1px solid rgba(0, 0, 0, .10);
  color: rgba(0, 0, 0, .42);
  font-size: 8px;
  font-weight: 600;
  letter-spacing: .12em;
}

@media (max-width: 680px) {
  .app-folder-window {
    width: calc(100vw - 20px);
    min-width: 0;
    height: min(390px, calc(100vh - 24px));
  }

  .app-list {
    min-width: 520px;
  }
}

/* GALANACCI UI scrollbar â€” desktop + mobile where the browser exposes it. */
.app-folder-body {
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 0, 0, .72) var(--bg);
  scrollbar-gutter: stable;
}

.app-folder-body::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.app-folder-body::-webkit-scrollbar-track {
  background: var(--bg);
}

.app-folder-body::-webkit-scrollbar-thumb {
  min-width: 32px;
  min-height: 32px;
  background: rgba(0, 0, 0, .72);
  border: 2px solid var(--bg);
  border-radius: 0;
}

.app-folder-body::-webkit-scrollbar-thumb:hover {
  background: #000;
}

.app-folder-body::-webkit-scrollbar-corner {
  background: var(--bg);
}

.app-folder-body::-webkit-scrollbar-button {
  display: none;
  width: 0;
  height: 0;
}

@media (max-width: 680px), (hover: none), (pointer: coarse) {
  .app-folder-body::-webkit-scrollbar {
    width: 7px;
    height: 7px;
  }

  .app-folder-body::-webkit-scrollbar-thumb {
    border-width: 1px;
  }
}

/* MOBILE FOLDER STACKED LIST V1 START */
/*
  Desktop keeps the table.
  Mobile/touch uses readable stacked cards instead of a cropped horizontal table.
*/
@media (max-width: 680px), (hover: none), (pointer: coarse) {
  .app-folder-window {
    width: calc(100vw - 18px);
    min-width: 0;
    height: min(560px, calc(100dvh - 148px));
    max-height: calc(100dvh - 148px);
  }

  .app-folder-body {
    overflow-x: hidden;
    overflow-y: auto;
    background: #fff;
    background-image: none;
  }

  .app-list {
    width: 100%;
    min-width: 0;
  }

  .app-list__header {
    display: none;
  }

  .app-list__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    min-height: 0;
    width: 100%;
    padding: 16px 14px 14px;
    border-bottom: 1px solid rgba(0, 0, 0, .14);
    background: #fff;
  }

  .app-list__row:hover,
  .app-list__row.is-selected,
  .app-list__row:focus-visible {
    background: rgba(0, 0, 0, .055);
  }

  .app-list__row > span {
    display: block;
    min-width: 0;
    height: auto;
    padding: 0;
  }

  .app-list__row > span + span {
    border-left: 0;
  }

  .app-list__name {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .055em;
    line-height: 1.2;
  }

  .app-list__name img {
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
  }

  .app-list__name span {
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .app-list__row > span:not(.app-list__name) {
    margin-top: 9px;
    padding-left: 46px;
    color: rgba(0, 0, 0, .74);
    font-size: 11px;
    line-height: 1.45;
    letter-spacing: .045em;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }

  .app-list__row > span:not(.app-list__name)::before {
    display: block;
    margin-bottom: 3px;
    color: rgba(0, 0, 0, .42);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1;
  }

  /*
    Folder-specific labels.
    APPS currently has: NAME / DATE CREATED / CREATED BY.
    SS may have: NAME / DESCRIPTION / DATE CREATED / CREATED BY.
  */
  #apps-folder-window .app-list__row > span:nth-child(2)::before {
    content: "DATE CREATED";
  }

  #apps-folder-window .app-list__row > span:nth-child(3)::before {
    content: "CREATED BY";
  }

  #ss-folder-window .app-list__row > span:nth-child(2)::before {
    content: "DESCRIPTION";
  }

  #ss-folder-window .app-list__row > span:nth-child(3)::before {
    content: "DATE CREATED";
  }

  #ss-folder-window .app-list__row > span:nth-child(4)::before {
    content: "CREATED BY";
  }

  .app-list__empty {
    min-height: 0;
    padding: 18px 14px;
    font-size: 10px;
    line-height: 1.45;
    white-space: normal;
  }
}
/* MOBILE FOLDER STACKED LIST V1 END */
