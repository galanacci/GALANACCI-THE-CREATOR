:root {
  --bg: #ead1b2;
  --fg: #000;
  --accent: #000;
  --accent-light: #000;
  --grid-line: rgba(0, 0, 0, .12);
  --grid-size: 16px;
  --shortcut-width: 100px;
  --shortcut-min-height: 112px;
  --shortcut-gap: 7px;
  --shortcut-padding: 8px 4px;
  --shortcut-font-size: 12px;
  --shortcut-icon-size: 74px;
  --edge: 20px;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
  --font-brand: "Lora", serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-brand);
  overflow: hidden;
  overscroll-behavior: none;
}

body {
  position: fixed;
  inset: 0;
  user-select: none;
  -webkit-user-select: none;
}

button {
  font: inherit;
  -webkit-tap-highlight-color: transparent;
}

.desktop {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background-color: var(--bg);
  background-image:
    linear-gradient(var(--grid-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
  background-size: var(--grid-size) var(--grid-size);
}

.desktop-apps {
  position: absolute;
  inset: 0;
}

.desktop-shortcut {
  position: absolute;
  top: 0;
  left: 0;
  width: var(--shortcut-width);
  min-height: var(--shortcut-min-height);
  display: grid;
  place-items: center;
  align-content: start;
  gap: var(--shortcut-gap);
  padding: var(--shortcut-padding);
  border: 1px solid transparent;
  background: transparent;
  color: var(--fg);
  font-size: var(--shortcut-font-size);
  font-weight: 600;
  letter-spacing: .07em;
  line-height: 1;
  cursor: pointer;
  touch-action: none;
  visibility: hidden;
  transition:
    background-color 100ms ease,
    border-color 100ms ease,
    color 100ms ease,
    opacity 100ms ease;
}

.desktop-shortcut.is-ready {
  visibility: visible;
}

.desktop-shortcut img {
  width: var(--shortcut-icon-size);
  height: var(--shortcut-icon-size);
  object-fit: contain;
  pointer-events: none;
}

.desktop-shortcut span,
.folder-item span {
  white-space: nowrap;
}

.desktop-shortcut:hover,
.desktop-shortcut.is-selected,
.desktop-shortcut:focus-visible,
.folder-item.is-selected,
.folder-item:focus-visible {
  outline: 0;
  border-color: rgba(0, 0, 0, .72);
  background: rgba(0, 0, 0, .12);
}

.desktop-shortcut:active {
  border-color: var(--accent-light);
}

.desktop-shortcut[aria-disabled="true"] {
  opacity: .38;
}

.desktop-hint {
  position: absolute;
  top: 0;
  left: 0;
  width: max-content;
  max-width: calc(100vw - 16px);
  margin: 0;
  color: rgba(0, 0, 0, .68);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .16em;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 220ms ease, visibility 0s linear 220ms;
}

.desktop-hint.is-visible {
  opacity: 1;
  visibility: visible;
  transition-delay: 0s;
}

.desktop-meta {
  position: fixed;
  left: calc(18px + var(--safe-left));
  right: calc(18px + var(--safe-right));
  bottom: calc(15px + var(--safe-bottom));
  display: flex;
  justify-content: space-between;
  gap: 16px;
  color: var(--fg);
  font-size: 8px;
  font-weight: 600;
  letter-spacing: .13em;
  pointer-events: none;
}

.folder-window {
  position: fixed;
  display: flex;
  flex-direction: column;
  top: 50%;
  left: 50%;
  z-index: 50;
  width: min(520px, calc(100vw - 32px));
  height: min(360px, calc(100vh - 48px));
  min-width: 300px;
  min-height: 220px;
  max-height: calc(100vh - 48px);
  overflow: hidden;
  resize: none;
  border: 1px solid rgba(0, 0, 0, .5);
  background: var(--bg);
  box-shadow: none;
  opacity: 1;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(1);
  transition: none;
}

.folder-window[hidden] {
  display: none;
}

.folder-window.is-open {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, -50%) scale(1);
}

.folder-window__chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 40px;
  padding-left: 14px;
  border-bottom: 1px solid rgba(0, 0, 0, .22);
  color: var(--fg);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .14em;
  cursor: move;
  user-select: none;
  touch-action: none;
}

.folder-window__close {
  width: 40px;
  height: 40px;
  border: 0;
  background: transparent;
  color: var(--fg);
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
}

.folder-window__close:hover,
.folder-window__close:focus-visible {
  background: rgba(0, 0, 0, .12);
  outline: 0;
}

.folder-window__body {
  position: relative;
  display: block;
  flex: 1 1 auto;
  min-height: 0;
  min-height: 180px;
  padding: 0;
  overflow: auto;
  background-color: var(--bg);
  background-image:
    linear-gradient(var(--grid-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
  background-size: var(--grid-size) var(--grid-size);
}

.folder-item {
  display: grid;
  align-self: start;
  position: absolute;
  left: 20px;
  top: 20px;
  place-items: center;
  align-content: start;
  width: var(--shortcut-width);
  min-height: var(--shortcut-min-height);
  gap: var(--shortcut-gap);
  padding: var(--shortcut-padding);
  border: 1px solid transparent;
  color: var(--fg);
  font-size: var(--shortcut-font-size);
  font-weight: 600;
  letter-spacing: .08em;
  line-height: 1;
  text-decoration: none;
  cursor: pointer;
  touch-action: none;
  user-select: none;
}

.folder-item:hover,
.folder-item.is-selected {
  border-color: rgba(0, 0, 0, .5);
  background: rgba(0, 0, 0, .12);
  outline: 0;
}

.folder-item img {
  display: block;
  justify-self: center;
  width: var(--shortcut-icon-size);
  height: var(--shortcut-icon-size);
  object-fit: contain;
}

.folder-window__resize-handle {
  position: absolute;
  z-index: 3;
  touch-action: none;
}

.folder-window__resize-handle--n,
.folder-window__resize-handle--s {
  left: 12px;
  right: 12px;
  height: 8px;
  cursor: ns-resize;
}

.folder-window__resize-handle--n { top: 0; }
.folder-window__resize-handle--s { bottom: 0; }

.folder-window__resize-handle--e,
.folder-window__resize-handle--w {
  top: 12px;
  bottom: 12px;
  width: 8px;
  cursor: ew-resize;
}

.folder-window__resize-handle--e { right: 0; }
.folder-window__resize-handle--w { left: 0; }

.folder-window__resize-handle--ne,
.folder-window__resize-handle--se,
.folder-window__resize-handle--sw,
.folder-window__resize-handle--nw {
  width: 14px;
  height: 14px;
}

.folder-window__resize-handle--ne { top: 0; right: 0; cursor: nesw-resize; }
.folder-window__resize-handle--se { right: 0; bottom: 0; cursor: nwse-resize; }
.folder-window__resize-handle--sw { bottom: 0; left: 0; cursor: nesw-resize; }
.folder-window__resize-handle--nw { top: 0; left: 0; cursor: nwse-resize; }

.folder-window__resize-handle:hover {
  background: rgba(0, 0, 0, .12);
}

.experiment-window {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  flex-direction: column;
  background: #000;
  opacity: 1;
  pointer-events: none;
  transition: none;
}

.experiment-window[hidden] {
  display: none;
}

.experiment-window.is-open {
  opacity: 1;
  pointer-events: auto;
}

.experiment-window__chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 40px;
  padding-left: 14px;
  border-bottom: 1px solid rgba(0, 0, 0, .22);
  background: var(--bg);
  color: var(--fg);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .14em;
}

.experiment-window__body {
  flex: 1 1 auto;
  min-height: 0;
}

.experiment-window__body iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #000;
}

.launch-transition {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  background: var(--bg);
  color: var(--fg);
  opacity: 0;
  transition: opacity 180ms ease;
}

.launch-transition[hidden] {
  display: none;
}

.launch-transition.is-open {
  opacity: 1;
}

.launch-transition__inner {
  width: min(360px, calc(100vw - 48px));
}

.launch-transition p {
  margin: 0 0 12px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .16em;
}

.launch-transition__track {
  display: block;
  width: 100%;
  height: 1px;
  background: rgba(0, 0, 0, .18);
  overflow: hidden;
}

.launch-transition__bar {
  display: block;
  width: 42%;
  height: 100%;
  background: var(--accent);
  transform: translateX(-110%);
}

.launch-transition.is-open .launch-transition__bar {
  animation: launch-line 560ms cubic-bezier(.4, 0, .2, 1) forwards;
}

@keyframes launch-line {
  to { transform: translateX(240%); }
}

@media (max-width: 680px) {
  :root {
    --shortcut-width: 90px;
    --shortcut-min-height: 98px;
    --shortcut-font-size: 11px;
    --shortcut-icon-size: 66px;
  }

  .desktop-shortcut {
    width: var(--shortcut-width);
    min-height: var(--shortcut-min-height);
    font-size: var(--shortcut-font-size);
  }

  .desktop-hint {
    font-size: 10px;
  }

  .desktop-meta {
    left: calc(14px + var(--safe-left));
    right: calc(14px + var(--safe-right));
    bottom: calc(13px + var(--safe-bottom));
  }

  .folder-item img {
    width: var(--shortcut-icon-size);
    height: var(--shortcut-icon-size);
  }

  .folder-item {
    width: var(--shortcut-width);
    min-height: var(--shortcut-min-height);
    font-size: var(--shortcut-font-size);
  }
}

@media (prefers-reduced-motion: reduce) {
  .desktop-shortcut,
  .desktop-hint,
  .launch-transition {
    transition: none;
  }

  .launch-transition.is-open .launch-transition__bar {
    animation: none;
    transform: none;
    width: 100%;
  }
}

/* GTC PORTFOLIO NOTICE V1 START */
.portfolio-notice-layer {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: grid;
  place-items: center;
  padding: 18px;
  background: transparent;
}
.portfolio-notice-layer[hidden] { display: none !important; }
.portfolio-notice {
  width: min(390px, calc(100vw - 36px));
  border: 1px solid #111;
  background: #e8dfd2;
  color: #111;
  box-shadow: none;
  font-family: inherit;
}
.portfolio-notice__chrome {
  min-height: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 4px 7px 4px 9px;
  border-bottom: 1px solid #111;
  background: #ead1b2;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
  user-select: none;
}
.portfolio-notice__close {
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  background: transparent;
  color: #111;
  font: inherit;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}
.portfolio-notice__body {
  display: grid;
  grid-template-columns: 46px 1fr;
  align-items: center;
  gap: 16px;
  padding: 22px 24px 14px;
}
.portfolio-notice__icon { width: 42px; height: 42px; display: block; object-fit: contain; }
.portfolio-notice__body p { margin: 0; font-size: 13px; line-height: 1.45; letter-spacing: .035em; }
.portfolio-notice__footer { display: flex; justify-content: center; padding: 8px 24px 20px; }
.portfolio-notice__ok {
  min-width: 74px;
  min-height: 28px;
  padding: 3px 16px;
  border: 1px solid #111;
  background: #ead1b2;
  color: #111;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
  border-radius: 0;
  box-shadow: none;
}
.portfolio-notice__ok:active { transform: translate(1px, 1px); }
@media (max-width: 600px) {
  .portfolio-notice { width: min(330px, calc(100vw - 28px)); }
  .portfolio-notice__body { grid-template-columns: 38px 1fr; gap: 13px; padding: 18px 18px 11px; }
  .portfolio-notice__icon { width: 36px; height: 36px; }
  .portfolio-notice__body p { font-size: 12px; }
  .portfolio-notice__footer { padding-bottom: 16px; }
}
/* GTC PORTFOLIO NOTICE V1 END */

/* GTC FOLDER WHITE + NOTICE MATCH V2 START */

/* Folder windows:
   white interior / cream title bar. */
.folder-window {
  background: #ffffff !important;
}

.folder-window__chrome {
  background: #ead1b2 !important;
}

.folder-window__body,
.app-folder-body,
.folder-window .app-list {
  background: #ffffff !important;
}

/* Keep ordinary list rows visually on the white folder surface.
   Existing hover / selected states are intentionally left alone. */
.folder-window .app-list__row:not(.is-selected):not(:hover) {
  background: #ffffff;
}

/* Initial portfolio notice:
   same visual grammar as the folder pop-up window. */
.portfolio-notice-layer {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: grid;
  place-items: center;
  padding: 18px;
  background: transparent;
}

.portfolio-notice-layer[hidden] {
  display: none !important;
}

.portfolio-notice {
  width: min(430px, calc(100vw - 36px));
  border: 1px solid #111;
  background: #ffffff;
  color: #111;
  box-shadow: none;
  font-family: inherit;
}

.portfolio-notice__chrome {
  min-height: 28px;
  cursor: default;
}

.portfolio-notice__body {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr);
  grid-template-areas:
    "icon copy"
    ". button";
  align-items: center;
  column-gap: 16px;
  row-gap: 16px;
  padding: 22px 24px 20px;
  background: #ffffff !important;
}

.portfolio-notice__icon {
  grid-area: icon;
  width: 42px;
  height: 42px;
  display: block;
  object-fit: contain;
}

.portfolio-notice__body p {
  grid-area: copy;
  margin: 0;
  font-size: 13px;
  line-height: 1.45;
  letter-spacing: .035em;
}

.portfolio-notice__ok {
  grid-area: button;
  justify-self: center;
  min-width: 76px;
  min-height: 28px;
  padding: 3px 16px;
  border: 1px solid #111;
  background: #ead1b2;
  color: #111;
  border-radius: 0;
  box-shadow: none;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
}

.portfolio-notice__ok:active {
  transform: translate(1px, 1px);
}

@media (max-width: 600px) {
  .portfolio-notice {
    width: min(340px, calc(100vw - 28px));
  }

  .portfolio-notice__body {
    grid-template-columns: 38px minmax(0, 1fr);
    column-gap: 13px;
    row-gap: 14px;
    padding: 18px 18px 16px;
  }

  .portfolio-notice__icon {
    width: 36px;
    height: 36px;
  }

  .portfolio-notice__body p {
    font-size: 12px;
  }
}

/* GTC FOLDER WHITE + NOTICE MATCH V2 END */

/* GTC FOLDER GRID + NOTIFICATION V3 START */

/* Folder window interior stays white; chrome stays GALANACCI cream. */
.folder-window {
  background: #ffffff !important;
}

.folder-window__chrome {
  background: #ead1b2 !important;
}

.folder-window__body,
.app-folder-body {
  padding: 0 !important;
  background: #ffffff !important;
  overflow: hidden;
}

/* Make the list and its grid lines reach the folder-window edges. */
.folder-window .app-list,
.folder-window .folder-list {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  background: #ffffff !important;
}

/* Column header row: white, not cream. */
.folder-window .app-list__header,
.folder-window .folder-list__header {
  width: 100% !important;
  margin: 0 !important;
  background: #ffffff !important;
  color: #111111 !important;
  border-bottom: 1px solid #d3d3d3 !important;
}

/* Data rows fill the complete popup width. */
.folder-window .app-list__row,
.folder-window .folder-item {
  width: 100% !important;
  margin: 0 !important;
  background: #ffffff;
  border-bottom: 1px solid #d3d3d3 !important;
}

/* Extend the vertical grid dividers from one edge of every row to the other. */
.folder-window .app-list__header > span,
.folder-window .app-list__row > span,
.folder-window .folder-list__header > span,
.folder-window .folder-item > span {
  min-width: 0;
  height: 100%;
  border-right: 1px solid #d3d3d3;
}

.folder-window .app-list__header > span:last-child,
.folder-window .app-list__row > span:last-child,
.folder-window .folder-list__header > span:last-child,
.folder-window .folder-item > span:last-child {
  border-right: 0;
}

/* Generic placeholder icon for every .EXE row. */
.folder-window .app-list__name img,
.folder-window .folder-item__name img {
  width: 26px !important;
  height: 26px !important;
  object-fit: contain !important;
  flex: 0 0 26px !important;
}

/* Initial notification: same chrome language as folder windows,
   but compact and unmistakably a notification. */
.portfolio-notice-layer {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: grid;
  place-items: center;
  padding: 18px;
  background: transparent;
}

.portfolio-notice-layer[hidden] {
  display: none !important;
}

.portfolio-notice {
  width: min(360px, calc(100vw - 32px));
  border: 1px solid #111111;
  background: #ead1b2;
  color: #111111;
  box-shadow: none !important;
  font-family: inherit;
}

.portfolio-notice__chrome {
  /* Uses folder-window__chrome so height/padding match folder windows. */
  background: #ead1b2 !important;
}

.portfolio-notice__body {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  min-height: 118px;
  padding: 22px 24px 20px !important;
  background: #ead1b2 !important;
  text-align: center;
}

.portfolio-notice__body p {
  margin: 0;
  max-width: 280px;
  font-size: 12px;
  line-height: 1.45;
  letter-spacing: .035em;
}

.portfolio-notice__ok {
  min-width: 76px;
  min-height: 28px;
  padding: 3px 18px;
  border: 1px solid #111111;
  border-radius: 0 !important;
  background: #ead1b2;
  color: #111111;
  box-shadow: none !important;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
}

.portfolio-notice__ok:active {
  transform: translate(1px, 1px);
}

/* Explicitly suppress any old notification icon left over from previous CSS. */
.portfolio-notice__icon {
  display: none !important;
}

/* GTC FOLDER GRID + NOTIFICATION V3 END */

/* GTC DESCRIPTION + OS NOTICE V4 START */

/* ----------------------------------------------------------
   FOLDER LIST â€” add DESCRIPTION as fourth column.
   ---------------------------------------------------------- */

.folder-window .app-list__header,
.folder-window .app-list__row {
  width: 100% !important;
  display: grid !important;
  grid-template-columns:
    minmax(150px, 1.7fr)
    105px
    110px
    minmax(190px, 2.3fr) !important;
  align-items: stretch;
}

.folder-window .app-list__header {
  background: #ffffff !important;
  color: #111111 !important;
}

.folder-window .app-list__header > span,
.folder-window .app-list__row > span {
  min-width: 0;
  border-right: 1px solid #d3d3d3;
}

.folder-window .app-list__header > span:last-child,
.folder-window .app-list__row > span:last-child {
  border-right: 0;
}

.folder-window .app-list__description-header {
  display: flex;
  align-items: center;
  padding: 0 12px;
  background: #ffffff;
  color: #111111;
  font: inherit;
}

.folder-window .app-list__description {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  background: #ffffff;
  color: #111111;
  font-size: 11px;
  line-height: 1.35;
  white-space: normal;
}

/* Keep grid lines running to the complete window edges. */
.folder-window__body,
.app-folder-body {
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.folder-window .app-list {
  width: 100% !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

/* ----------------------------------------------------------
   GALANACCI OS 26 notification.
   White body/window + cream header and cream OK button.
   ---------------------------------------------------------- */

.portfolio-notice-layer {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: grid;
  place-items: center;
  padding: 18px;
  background: transparent;
}

.portfolio-notice-layer[hidden] {
  display: none !important;
}

.portfolio-notice {
  width: min(390px, calc(100vw - 32px));
  border: 1px solid #111111;
  background: #ffffff !important;
  color: #111111;
  box-shadow: none !important;
  font-family: inherit;
}

.portfolio-notice__chrome {
  background: #ead1b2 !important;
}

.portfolio-notice__body {
  display: grid !important;
  grid-template-columns: 42px minmax(0, 1fr);
  grid-template-areas:
    "icon copy"
    ". button";
  align-items: center;
  column-gap: 16px;
  row-gap: 18px;
  min-height: 124px;
  padding: 22px 24px 20px !important;
  background: #ffffff !important;
}

.portfolio-notice__icon {
  grid-area: icon;
  display: block !important;
  width: 38px;
  height: 38px;
  object-fit: contain;
  /* Existing transparent favicon becomes solid black in this window only. */
  filter: brightness(0) saturate(100%);
}

.portfolio-notice__body p {
  grid-area: copy;
  margin: 0;
  color: #111111;
  font-size: 13px;
  line-height: 1.45;
  letter-spacing: .025em;
  text-transform: none;
}

.portfolio-notice__ok {
  grid-area: button;
  justify-self: center;
  min-width: 76px;
  min-height: 28px;
  padding: 3px 18px;
  border: 1px solid #111111;
  border-radius: 0 !important;
  background: #ead1b2 !important;
  color: #111111;
  box-shadow: none !important;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
}

.portfolio-notice__ok:active {
  transform: translate(1px, 1px);
}

@media (max-width: 760px) {
  .folder-window .app-list__header,
  .folder-window .app-list__row {
    grid-template-columns:
      minmax(130px, 1.5fr)
      86px
      92px
      minmax(170px, 2fr) !important;
  }

  .folder-window .app-list__description {
    font-size: 10px;
  }

  .portfolio-notice {
    width: min(340px, calc(100vw - 28px));
  }

  .portfolio-notice__body {
    grid-template-columns: 36px minmax(0, 1fr);
    column-gap: 13px;
    padding: 18px 18px 16px !important;
  }

  .portfolio-notice__icon {
    width: 32px;
    height: 32px;
  }

  .portfolio-notice__body p {
    font-size: 12px;
  }
}

/* GTC DESCRIPTION + OS NOTICE V4 END */

/* GTC STABLE ROW HIGHLIGHT V5.2 START */

/* Whole-row highlight, restored to neutral grey. */
.folder-window .app-list__row {
  cursor: pointer;
}

.folder-window .app-list__row:hover,
.folder-window .app-list__row.is-selected,
.folder-window .app-list__row[aria-selected="true"],
.folder-window .app-list__row:focus-within {
  background: #e9e9e9 !important;
}

.folder-window .app-list__row:hover > *,
.folder-window .app-list__row.is-selected > *,
.folder-window .app-list__row[aria-selected="true"] > *,
.folder-window .app-list__row:focus-within > * {
  background: #e9e9e9 !important;
}

/* Keep the OS notification white and centered. */
.portfolio-notice-layer[hidden] {
  display: none !important;
}

.portfolio-notice__icon {
  display: none !important;
}

.portfolio-notice__body {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  min-height: 124px;
  padding: 22px 24px 20px !important;
  background: #ffffff !important;
  text-align: center;
}

.portfolio-notice__body p {
  width: 100%;
  max-width: 290px;
  margin: 0 auto !important;
  text-align: center;
}

.portfolio-notice__ok {
  align-self: center;
  border-radius: 0 !important;
}

/* GTC STABLE ROW HIGHLIGHT V5.2 END */

/* GTC LEGACY MOBILE WINDOW SYSTEM V6.6 START */

/* Old backup window geometry:
   same floating folder-window model on desktop and mobile. */
.folder-window {
  position: fixed;
  display: flex;
  flex-direction: column;

  top: 50%;
  left: 50%;

  width: min(520px, calc(100vw - 32px));
  height: min(360px, calc(100vh - 48px));

  min-width: min(300px, calc(100vw - 16px));
  min-height: min(220px, calc(100vh - 16px));

  max-width: calc(100vw - 16px);
  max-height: calc(100vh - 16px);

  overflow: hidden;
  resize: none;

  transform: translate(-50%, -50%);
}

@supports (height: 100dvh) {
  .folder-window {
    height: min(360px, calc(100dvh - 48px));
    min-height: min(220px, calc(100dvh - 16px));
    max-height: calc(100dvh - 16px);
  }
}

.folder-window.is-open {
  transform: translate(-50%, -50%);
}

.folder-window__chrome {
  cursor: move;
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;
}

.folder-window__body,
.app-folder-body {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
}

/* Restore the exact 8-handle architecture visible in the old backup. */
.folder-window__resize-handle {
  position: absolute;
  z-index: 30;
  touch-action: none;
}

.folder-window__resize-handle--n,
.folder-window__resize-handle--s {
  left: 12px;
  right: 12px;
  height: 8px;
  cursor: ns-resize;
}

.folder-window__resize-handle--n {
  top: 0;
}

.folder-window__resize-handle--s {
  bottom: 0;
}

.folder-window__resize-handle--e,
.folder-window__resize-handle--w {
  top: 12px;
  bottom: 12px;
  width: 8px;
  cursor: ew-resize;
}

.folder-window__resize-handle--e {
  right: 0;
}

.folder-window__resize-handle--w {
  left: 0;
}

.folder-window__resize-handle--ne,
.folder-window__resize-handle--se,
.folder-window__resize-handle--sw,
.folder-window__resize-handle--nw {
  width: 16px;
  height: 16px;
}

.folder-window__resize-handle--ne {
  top: 0;
  right: 0;
  cursor: nesw-resize;
}

.folder-window__resize-handle--se {
  right: 0;
  bottom: 0;
  cursor: nwse-resize;
}

.folder-window__resize-handle--sw {
  bottom: 0;
  left: 0;
  cursor: nesw-resize;
}

.folder-window__resize-handle--nw {
  top: 0;
  left: 0;
  cursor: nwse-resize;
}

/* Current table layout remains:
   NAME | DESCRIPTION | DATE CREATED | CREATED BY */
.folder-window .app-list__header,
.folder-window .app-list__row {
  display: grid !important;
  grid-template-columns:
    minmax(190px, 1.45fr)
    minmax(240px, 2fr)
    110px
    120px !important;
  width: 100% !important;
  align-items: stretch;
}

.folder-window .app-list__description {
  color: inherit !important;
}

/* Mobile: window stays desktop-like.
   Only the wide table scrolls horizontally. */
@media (max-width: 760px) {
  .folder-window {
    width: min(520px, calc(100vw - 24px));
    height: min(360px, calc(100vh - 56px));

    min-width: min(280px, calc(100vw - 16px));
    min-height: min(220px, calc(100vh - 16px));
  }

  @supports (height: 100dvh) {
    .folder-window {
      height: min(360px, calc(100dvh - 56px));
      min-height: min(220px, calc(100dvh - 16px));
    }
  }

  .folder-window .app-list {
    width: 860px !important;
    min-width: 860px !important;
    max-width: none !important;
  }

  .folder-window .app-list__header,
  .folder-window .app-list__row {
    width: 860px !important;
    min-width: 860px !important;
    max-width: 860px !important;

    grid-template-columns:
      230px
      350px
      120px
      160px !important;
  }

  .folder-window .app-list__header > *,
  .folder-window .app-list__row > *,
  .folder-window .app-list__name,
  .folder-window .app-list__description,
  .folder-window .gtc-date-cell,
  .folder-window .gtc-created-cell {
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: clip !important;
    overflow-wrap: normal !important;
    word-break: normal !important;
  }

  /* Slightly larger invisible corners for finger resizing,
     while keeping the old visual behavior. */
  .folder-window__resize-handle--ne,
  .folder-window__resize-handle--se,
  .folder-window__resize-handle--sw,
  .folder-window__resize-handle--nw {
    width: 24px;
    height: 24px;
  }
}

/* GTC LEGACY MOBILE WINDOW SYSTEM V6.6 END */

/* MOBILE FOLDER CLOSE RESIZE SAFEZONE V1 START */
/*
  On touch devices, the folder close button and the north-east resize
  corner compete for the same top-right area. Keep the close button as
  the only active top-right target and move resize affordances away from it.
*/
@media (hover: none), (pointer: coarse) {
  .folder-window__close {
    position: relative;
    z-index: 5;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .folder-window__resize-handle--ne {
    display: none;
    pointer-events: none;
  }

  .folder-window__resize-handle--n {
    right: 52px;
  }

  .folder-window__resize-handle--e {
    top: 52px;
  }

  .folder-window__resize-handle:hover {
    background: transparent;
  }
}
/* MOBILE FOLDER CLOSE RESIZE SAFEZONE V1 END */
