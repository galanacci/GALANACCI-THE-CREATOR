<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <meta name="description" content="GALANACCI THE CREATOR â€” archive, experiments, brands and worlds.">
  <title>GALANACCI THE CREATOR</title>

  <link rel="stylesheet" href="style.css?v=mobile-folder-v6-3">
  <link rel="stylesheet" href="styles/app-folder-list.css?v=20260919-ss-folder-v3">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg?v=ui-favicon-v2">
</head>

<body>
  <main id="gtc-desktop" class="desktop" aria-label="GALANACCI THE CREATOR desktop">
    <div id="desktop-apps" class="desktop-apps" aria-label="Desktop applications"></div>
    <p id="desktop-hint" class="desktop-hint" aria-hidden="true"></p>
    <div class="desktop-meta" aria-hidden="true">
      <span>GALANACCI THE CREATOR</span>
      <span>DESKTOP_039</span>
    </div>
  </main>

  <section
    id="apps-folder-window"
    class="folder-window app-folder-window"
    data-folder-window="apps"
    hidden
    aria-hidden="true"
    role="dialog"
    aria-labelledby="apps-folder-title"
  >
    <header class="folder-window__chrome">
      <span id="apps-folder-title">APPS</span>
      <button type="button" class="folder-window__close" data-close-folder aria-label="Close APPS folder">&times;</button>
    </header>

    <div class="folder-window__body app-folder-body">
      <div class="app-list" role="table" aria-label="Applications">
        <div class="app-list__header" role="row">
          <span role="columnheader">NAME</span>
          <span role="columnheader">DATE CREATED</span>
          <span role="columnheader">CREATED BY</span>
        </div>

        <a
          class="app-list__row"
          data-app-link
          data-label="2(XY+T).EXE"
          href="./experiments/2(XY-T)/index.html"
          aria-label="Open 2(XY+T).EXE experiment"
          role="row"
        >
          <span class="app-list__name" role="cell">
            <img src="assets/icons/EXE_PLACEHOLDER.svg" alt="" draggable="false">
            <span>2(XY+T).EXE</span>
          </span>
          <span class="app-list__meta" role="cell">19/09/2026</span>
          <span class="app-list__meta" role="cell">GALANACCI</span>
        </a>
      </div>
    </div>

    <span class="folder-window__resize-handle folder-window__resize-handle--n" data-resize="n" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--e" data-resize="e" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--s" data-resize="s" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--w" data-resize="w" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--ne" data-resize="ne" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--se" data-resize="se" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--sw" data-resize="sw" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--nw" data-resize="nw" aria-hidden="true"></span>
  </section>

  <section
    id="ss-folder-window"
    class="folder-window app-folder-window"
    data-folder-window="ss"
    hidden
    aria-hidden="true"
    role="dialog"
    aria-labelledby="ss-folder-title"
  >
    <header class="folder-window__chrome">
      <span id="ss-folder-title">SS</span>
      <button type="button" class="folder-window__close" data-close-folder aria-label="Close SS folder">&times;</button>
    </header>

    <div class="folder-window__body app-folder-body">
      <div class="app-list" role="table" aria-label="SS archive">
        <div class="app-list__header" role="row">
          <span role="columnheader">NAME</span>
          <span role="columnheader">DATE CREATED</span>
          <span role="columnheader">CREATED BY</span>
        </div>

        <a
          class="app-list__row"
          data-app-link
          data-label="WARRIORSOFBOXING.EXE"
          href="./SS/WARRIORSOFBOXING/index.html"
          aria-label="Open WARRIORSOFBOXING.EXE"
          role="row"
        >
          <span class="app-list__name" role="cell">
            <img src="assets/icons/EXE_PLACEHOLDER.svg" alt="" draggable="false">
            <span>WARRIORSOFBOXING.EXE</span>
          </span>
          <span class="app-list__meta" role="cell">2022</span>
          <span class="app-list__meta" role="cell">GALANACCI</span>
        </a>


        <a
          class="app-list__row"
          data-app-link
          data-label="EVERYDAYS.EXE"
          href="./SS/EVERYDAYS/index.html"
          aria-label="Open EVERYDAYS.EXE"
          role="row"
        >
          <span class="app-list__name" role="cell">
            <img src="assets/icons/EXE_PLACEHOLDER.svg" alt="" draggable="false">
            <span>EVERYDAYS.EXE</span>
          </span>
          <span class="app-list__meta" role="cell">2021</span>
          <span class="app-list__meta" role="cell">GALANACCI</span>
        </a>


        <a
          class="app-list__row"
          data-app-link
          data-label="BLACKBOOK.EXE"
          href="./SS/BLACKBOOK/index.html"
          aria-label="Open BLACKBOOK.EXE"
          role="row"
        >
          <span class="app-list__name" role="cell">
            <img src="assets/icons/EXE_PLACEHOLDER.svg" alt="" draggable="false">
            <span>BLACKBOOK.EXE</span>
          </span>
          <span class="app-list__meta" role="cell">2020</span>
          <span class="app-list__meta" role="cell">GALANACCI</span>
        </a>

        <a
          class="app-list__row"
          data-app-link
          data-label="RENAISSANCE.EXE"
          href="./SS/RENAISSANCE/index.html"
          aria-label="Open RENAISSANCE.EXE"
          role="row"
        >
          <span class="app-list__name" role="cell">
            <img src="assets/icons/EXE_PLACEHOLDER.svg" alt="" draggable="false">
            <span>RENAISSANCE.EXE</span>
          </span>
          <span class="app-list__meta" role="cell">2021</span>
          <span class="app-list__meta" role="cell">GALANACCI</span>
        </a>

      </div>
    </div>

    <span class="folder-window__resize-handle folder-window__resize-handle--n" data-resize="n" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--e" data-resize="e" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--s" data-resize="s" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--w" data-resize="w" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--ne" data-resize="ne" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--se" data-resize="se" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--sw" data-resize="sw" aria-hidden="true"></span>
    <span class="folder-window__resize-handle folder-window__resize-handle--nw" data-resize="nw" aria-hidden="true"></span>
  </section>

  <section id="experiment-window" class="experiment-window" hidden aria-hidden="true" role="dialog" aria-labelledby="experiment-window-title">
    <header class="experiment-window__chrome">
      <span id="experiment-window-title">APP</span>
      <button type="button" class="folder-window__close" data-close-experiment aria-label="Close app">&times;</button>
    </header>
    <div class="experiment-window__body">
      <iframe id="experiment-frame" title="App" allow="autoplay; fullscreen"></iframe>
    </div>
  </section>

  <section id="launch-transition" class="launch-transition" hidden aria-hidden="true">
    <div class="launch-transition__inner">
      <p id="launch-label">OPENING...</p>
      <span class="launch-transition__track" aria-hidden="true">
        <span class="launch-transition__bar"></span>
      </span>
    </div>
  </section>

  
  <!-- GTC PORTFOLIO NOTICE V1 START -->
<div
  id="portfolio-notice-layer"
  class="portfolio-notice-layer"
  hidden
  aria-hidden="true"
>
  <section
    id="portfolio-notice"
    class="portfolio-notice"
    role="dialog"
    aria-modal="true"
    aria-labelledby="portfolio-notice-title"
    aria-describedby="portfolio-notice-copy"
  >
    <header class="folder-window__chrome portfolio-notice__chrome">
      <span id="portfolio-notice-title">NOTE</span>

      <button
        type="button"
        class="folder-window__close portfolio-notice__close"
        data-close-portfolio-notice
        aria-label="Close notice"
      >&times;</button>
    </header>

    <div class="portfolio-notice__body">
      <p id="portfolio-notice-copy">
        You are now using GALANACCI OS 26
      </p>

      <button
        type="button"
        class="portfolio-notice__ok"
        data-close-portfolio-notice
        autofocus
      >OK</button>
    </div>
  </section>
</div>
<!-- GTC PORTFOLIO NOTICE V1 END -->


  <script type="module" src="js/apps.js?v=20260919-ss-folder-v3"></script>
  <script type="module" src="js/desktop.js?v=app-open-repair-v5-2"></script>
  <script src="js/gtc-ui-enhancements.js?v=mobile-repair-v6-2"></script>
</body>
</html>









